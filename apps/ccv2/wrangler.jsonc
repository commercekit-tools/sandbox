{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "commercekit-sandbox-ccv2",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",

  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    {
      "pattern": "ccv2.sandbox.commercekit.tools",
      "custom_domain": true,
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CCV2_RUN",
        "class_name": "Ccv2Run",
      },
    ],
  },

  "exports": {
    "Ccv2Run": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },

  "vars": {
    "ALLOWED_ORIGINS": "https://commercekit.tools",
    "MOCK_JWT_ISSUER": "https://ccv2.sandbox.commercekit.tools",
  },

  "secrets": {
    "required": [
      "MOCK_JWT_PRIVATE_KEY",
      "MOCK_JWT_PUBLIC_JWK",
      "MOCK_JWT_KID",
      "RUN_TOKEN_SIGNING_KEY",
    ],
  },

  "ratelimits": [
    {
      "name": "RUN_CREATION_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}

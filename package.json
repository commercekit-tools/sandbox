{
  "name": "@commercekit-tools/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "dev:ccv2": "pnpm --filter @commercekit-tools/sandbox-ccv2 dev",
    "types:ccv2": "pnpm --filter @commercekit-tools/sandbox-ccv2 types",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @commercekit-tools/sandbox-ccv2 typecheck",
    "test": "pnpm --filter @commercekit-tools/sandbox-ccv2 test",
    "build:check": "pnpm --filter @commercekit-tools/sandbox-ccv2 build:check",
    "ci": "pnpm --filter @commercekit-tools/sandbox-ccv2 types:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.2"
  }
}
